---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { WritingArchive, type WritingPost } from "../components/writing";

const rawPosts = await getCollection("writing");

// Sort by date descending and assign 2-digit indices
const posts: WritingPost[] = rawPosts
  .filter((post) => Boolean(post.data.date && post.data.title && post.data.title !== "Untitled"))
  .map((post) => {
    const uuid = post.id.split("/").pop()?.replace(/\.md$/, "") || post.id;
    const rawDate = post.data.date;
    const displayDate = rawDate.slice(0, 10).replace(/-/g, ".");
    return {
      uuid,
      index: "00",
      title: post.data.title,
      rawDate,
      date: displayDate,
      category: post.data.category || "general",
      summary: post.data.summary || "",
      tags: post.data.tags || [],
      href: `${import.meta.env.BASE_URL.replace(/\/$/, "")}/writing/${uuid}`,
    };
  })
  .sort((a, b) => (b.rawDate > a.rawDate ? 1 : b.rawDate < a.rawDate ? -1 : 0))
  .map((item, idx) => ({
    ...item,
    index: String(idx + 1).padStart(2, "0"),
  }));
---

<BaseLayout
  title="Writting"
  description="Technical documentation, architecture case studies, and engineering essays."
  currentPath="/writing"
>
  <div class="flex flex-col w-full divide-y divide-border-hairline bg-surface-canvas">
    <WritingArchive posts={posts} />
  </div>
</BaseLayout>
