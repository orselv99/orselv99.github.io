---
import BaseLayout from "../layouts/BaseLayout.astro";

interface TaskDetail {
  description: string;
  link?: {
    label: string;
    href: string;
  };
}

interface Project {
  title: string;
  period: string;
  description: string;
  tasks: TaskDetail[];
  techStack?: string[];
}

interface Experience {
  id: string;
  index: string;
  company: string;
  period: string;
  role: string;
  location: string;
  category: "platform" | "systems" | "client" | "etc";
  isCurrent?: boolean;
  projects: Project[];
}

const experiences: Experience[] = [
  {
    id: "wizvera",
    index: "01",
    company: "위즈베라 ",
    period: "2023.06 — PRESENT",
    role: "Software Engineer / Frontend 2팀",
    location: "성수 / SEOUL",
    category: "client",
    isCurrent: true,
    projects: [
      {
        title: "상용 AI 서비스 제어 솔루션 (프로토타입)",
        period: "2026.02 — 2026.09",
        description: "사내 AI 인프라를 활용해, 상용 AI 서비스로 나가는 프롬프트와 첨부파일을 LLM으로 검사하는 서비스를 약 한 달 반 동안 혼자 전 영역 설계·구현했습니다. Python 프록시, LLM 분석 레이어, 브라우저 확장, 데스크톱 앱, Next.js 백오피스까지.",
        tasks: [
          {
            description: "AI 코딩 도구에 구현을 맡기고 아키텍처·장애 정책·오탐 처리는 직접 판단",
            link: { label: "AI", href: "/writing" },
          },
          {
            description: "모바일 앱의 SSL Pinning 때문에 프록시 기반 방식의 근본 한계를 확인하고 피봇 제안",
            link: { label: "AI", href: "/writing" },
          },
          {
            description: "LLM 추론 지연(2–4초)을 줄이기 위한 규칙 기반 1차 필터 + LLM 2차 판정 구조 ",
            link: { label: "AI", href: "#" },
          }
        ],
        techStack: ["Python", "Next.js", "ForwardProxy", "Docker", "vLLM"],
      },
      {
        title: "사용자 행동 분석 솔루션",
        period: "2023.06 — 2026.01",
        description: "PC에서 발생하는 프로세스·파일·네트워크 이벤트를 수집해 Logstash → ElasticSearch로 보내는 파이프라인과, 이를 조회하는 Next.js 백오피스를 만들었습니다.",
        tasks: [
          {
            description: "전송 실패 시 로컬 버퍼링, 복구 시 배치를 줄여 서버를 다시 쓰러뜨리지 않게",
            link: { label: "PIPELINE", href: "/writing" },
          },
          {
            description: "사용자가 바꿀 수 있는 로컬 시간 대신 수집 측 UTC를 병기",
            link: { label: "PIPELINE", href: "#" },
          },
          {
            description: "대량 데이터에서 text/keyword 매핑 재설계, deep pagination 대응",
            link: { label: "PIPELINE", href: "#" },
          },
          {
            description: "상시 실행이 무거운 파일 스캔은 사용자가 자리를 비우는 시간으로 스케줄 이동",
            link: { label: "PIPELINE", href: "#" },
          },
          {
            description: "백오피스를 CSR 대신 Next.js로 — 내부 API 노출 표면 기준 선택",
            link: { label: "PIPELINE", href: "#" },
          },
        ],
        techStack: ["Qt", "Windows", "ElasticSearch", "WebView", "React.Js"],
      },
    ],
  },
  {
    id: "wonderpeople",
    index: "02",
    company: "원더피플",
    period: "2021.10 — 2023.01",
    role: "Game Platform Engineer / 플랫폼실",
    location: "강남 / SEOUL",
    category: "platform",
    projects: [
      {
        title: "게임 플랫폼 데스크탑 클라이언트",
        period: "2021.10 — 2023.01",
        description: "전 세계 100개국 유저 대상 지연시간(RTT) 기반 최적 데이터센터 라우팅 및 티켓 큐 기반 랭크 매칭 알고리즘 구현",
        tasks: [
          {
            description: "델타 패치에 임계치를 두어, 여러 버전을 건너뛴 유저는 전체 다운로드로",
            link: { label: "MATCH-ALGO-V2", href: "#" },
          },
          {
            description: "진행 명세서를 먼저 기록해, 중단된 다운로드·패치를 그 지점부터 재개",
            link: { label: "BENCH-REPORT-Q4", href: "#" },
          },
          {
            description: "바이너리 업로드가 끝난 뒤 메타데이터를 마지막에 올려 부분 배포 노출 방지",
            link: { label: "CHAOS-HARNESS", href: "#" },
          },
          {
            description: "특정 OS 서비스가 항상 있다는 전제가 깨진 장애를 Sentry로 추적",
            link: { label: "CHAOS-HARNESS", href: "#" },
          },
          {
            description: "네이티브 GNB + WebView 콘텐츠로 배포 주기를 분리, 이후 Electron 차세대 클라이언트(약 70%, 회사 사정으로 중단)",
            link: { label: "CHAOS-HARNESS", href: "#" },
          },
          {
            description: "FPS 핵 대응으로 계정에 휴대폰 인증을 붙여 재가입 비용을 올림",
            link: { label: "CHAOS-HARNESS", href: "#" },
          },
        ],
        techStack: ["Qt", "RtPatch", "Electron", "React.Js", "Advanced Installer", "Sentry"],
      }
    ],
  },
  {
    id: "inzent",
    index: "03",
    company: "인젠트",
    period: "2018.05 — 2021.09",
    role: "Software Engineer / ECM 개발팀",
    location: "여의도 / SEOUL",
    category: "systems",
    projects: [
      {
        title: "DLP · 문서중앙화 솔루션",
        period: "2019.03 — 2020.05",
        description: "WebRTC 및 QUIC 프로토콜 기반 대규모 인터랙티브 라이브 방송 P2P 릴레이 게이트웨이 아키텍처 설계 및 프로덕션 배포",
        tasks: [
          {
            description: "QUIC / HTTP3 기반 프록시 파이프라인 작성으로 패킷 손실률 15% 환경에서도 무중단 오디오/비디오 전송 달성",
            link: { label: "QUIC-GATEWAY-SPEC", href: "#" },
          },
          {
            description: "커스텀 메모리 풀링(sync.Pool) 튜닝을 통해 GC Stop-the-world 지연 92% 제거 및 초당 버퍼 메모리 할당 병목 해소",
            link: { label: "MEM-OPTIMIZE-RFC", href: "#" },
          },
        ],
        techStack: ["C/C++", "Windows", "C#.Net Framework", "Express", "React.Js", "Jenkins", "InnoSetup"],
      }
    ],
  },
  {
    id: "workingholiday",
    index: "04",
    company: "워킹홀리데이",
    period: "2015.04 — 2018.04",
    role: "",
    location: "독일",
    category: "etc",
    projects: []
  },
  {
    id: "itmsystem",
    index: "05",
    company: "아이티엠시스템",
    period: "2012.11 — 2015.04",
    role: "Software Engineer / 연구소",
    location: "구로 / SEOUL",
    category: "systems",
    projects: [
      {
        title: "DLP 솔루션",
        period: "2016.03 — 2017.12",
        description: "HTML5 Canvas 및 Node.js 기반 실시간 다자간 상호작용 웹 게임 플랫폼 개발 및 프론트엔드/백엔드 풀스택 구현",
        tasks: [
          {
            description: "클라이언트 사이드 예측(Client-side prediction) 및 래그 보정(Lag compensation) 알고리즘 구현으로 입력 반응성 개선",
            link: { label: "NETCODE-STUDY", href: "#" },
          },
          {
            description: "AWS EC2 Auto-scaling 기반 탄력적 서버 풀링 구성 및 무중단 배포 자동화 스크립트 작성",
            link: { label: "DEPLOY-SCRIPTS", href: "#" },
          },
        ],
        techStack: ["C/C++", "Vb6.0", "Jenkins", "InnoSetup"],
      },
    ],
  },
];

const totalProjects = experiences.reduce((acc, curr) => acc + curr.projects.length, 0);
---

<BaseLayout
  title="02. RESUME // ORSEL — CAREER CHRONOLOGY & RECORD OF SERVICE"
  description="Curriculum vitae and professional experience of orseL. Lead Platform Engineer specializing in distributed systems, game platform architecture, and high-performance web runtimes."
  currentPath="/resume"
>
  <div class="flex flex-col w-full divide-y divide-border-hairline bg-surface-canvas">
    
    <!-- SECTION 1: SECTION DOSSIER / RESUME MASTHEAD -->
    <section class="py-space-lg md:py-space-xl space-y-space-lg bg-surface-canvas">
      <!-- Breadcrumb Bar -->
      <div class="flex flex-wrap items-center justify-between gap-space-sm pb-space-md border-b border-border-hairline">
        <div class="flex items-center gap-space-sm font-label-mono-xs text-label-mono-xs uppercase text-text-primary tracking-widest">
          <span class="inline-block w-2 h-2 bg-accent-spec"></span>
          <span>// 02. RESUME // CAREER CHRONOLOGY &amp; RECORD OF SERVICE</span>
        </div>
        <div class="flex items-center gap-space-md font-label-mono-xs text-label-mono-xs uppercase text-text-secondary">
          <span class="text-text-primary font-code-block font-bold">2016 — 2026 [10 YEARS]</span>
        </div>
      </div>

      <!-- Main Headline & Executive Summary Box -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-start">
        <div class="lg:col-span-8 flex flex-col gap-space-sm">
          <span class="font-label-mono text-label-mono text-text-secondary uppercase tracking-widest">
            [SECTION IDENTIFIER: 02_RESUME]
          </span>
          <h1 class="font-display-hero text-headline-lg md:text-display-hero uppercase text-text-primary tracking-tight leading-none">
            02 // CURRICULUM VITAE &amp; EXPERIENCE
          </h1>
          <p class="font-headline-sm text-headline-sm uppercase tracking-tight text-text-secondary pt-space-xs font-medium">
            Software Engineer · Game Platform · Web
          </p>
        </div>

        <!-- Quick Summary / Spec Matrix -->
        <div class="lg:col-span-4 border border-border-hairline bg-surface-subtle p-space-md flex flex-col justify-between gap-space-md">
          <div class="flex items-center justify-between border-b border-border-subtle pb-space-xs">
            <span class="font-label-mono-xs text-label-mono-xs uppercase font-semibold text-text-primary">
              PROFILE SPECIFICATION
            </span>
            <span class="font-label-mono-xs text-label-mono-xs uppercase text-accent-spec font-bold">
              [ACTIVE_LEAD]
            </span>
          </div>

          <div class="space-y-space-xs font-label-mono-xs text-label-mono-xs text-text-secondary">
            <div class="flex items-center justify-between">
              <span>CURRENT ROLE:</span>
              <span class="font-bold text-text-primary">LEAD PLATFORM ENGINEER</span>
            </div>
            <div class="flex items-center justify-between">
              <span>SPECIALTY:</span>
              <span class="font-bold text-text-primary">DISTRIBUTED SYSTEMS / GAME</span>
            </div>
            <div class="flex items-center justify-between">
              <span>ENTRIES COUNT:</span>
              <span class="font-bold text-text-primary">04 STATIONS / {String(totalProjects).padStart(2, "0")} PROJECTS</span>
            </div>
            <div class="flex items-center justify-between">
              <span>VERIFICATION:</span>
              <span class="font-bold text-text-primary">CRYPTOGRAPHICALLY ATTESTED</span>
            </div>
          </div>

          <div class="flex items-center gap-space-xs pt-space-xs border-t border-border-subtle">
            <button
              id="print-cv-btn"
              type="button"
              class="w-full flex items-center justify-center gap-2 py-1.5 px-space-sm bg-surface-inverse text-text-inverse font-label-mono-xs text-label-mono-xs uppercase hover:opacity-90 transition-none cursor-pointer select-none font-bold"
            >
              <span>[PRINT / PDF EXPORT]</span>
              <span>↓</span>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: VERTICAL TIMELINE ARCHITECTURE -->
    <section class="py-space-lg md:py-space-xl bg-surface-canvas">
      <!-- Outer container with vertical spine axis on the left -->
      <div class="relative pl-6 sm:pl-8 md:pl-10" id="timeline-container">
        
        <!-- Left Continuous Vertical Line (세로라인 좌측 배치) -->
        <div
          class="absolute left-[7px] top-3 bottom-6 w-0.5 bg-border-hairline pointer-events-none"
          aria-hidden="true"
        ></div>

        <!-- Timeline Entries -->
        <div class="space-y-space-xl" id="timeline-entries">
          {
            experiences.map((exp) => (
              <article
                class="timeline-card relative group"
                data-category={exp.category}
                id={`station-${exp.id}`}
              >
                <!-- Content Start Dot on the Left Vertical Line (컨텐츠 시작을 dot으로 표현) -->
                <div
                  class="absolute -left-6 sm:-left-8 md:-left-10 top-1.5 flex items-center justify-center select-none"
                  aria-hidden="true"
                >
                  {exp.isCurrent ? (
                    <div class="relative flex items-center justify-center">
                      <span class="absolute w-5 h-5 rounded-full bg-accent-spec/25 animate-ping pointer-events-none" style="border-radius: 9999px !important;"></span>
                      <svg class="w-4 h-4 text-accent-spec relative z-10" viewBox="0 0 16 16" fill="none">
                        <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="2" fill="var(--color-surface-canvas)"/>
                        <circle cx="8" cy="8" r="3" fill="currentColor"/>
                      </svg>
                    </div>
                  ) : (
                    <div class="relative flex items-center justify-center">
                      <svg class="w-4 h-4 text-text-primary relative z-10" viewBox="0 0 16 16" fill="none">
                        <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="2" fill="var(--color-surface-canvas)"/>
                        <circle cx="8" cy="8" r="3" fill="currentColor"/>
                      </svg>
                    </div>
                  )}
                </div>

                <!-- Main Company & Projects Wrapper -->
                <div class="space-y-space-md">
                  
                  <!-- COMPANY HEADER BLOCK: {회사이름} · {시작-끝} · {직책} -->
                  <header class="pb-space-xs border-b border-border-hairline">
                    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-sm">
                      
                      <!-- Required Format: {회사이름} · {시작-끝} · {직책} -->
                      <div class="flex flex-col items-baseline gap-x-space-sm gap-y-1">
                        <!-- {회사이름} -->
                        <h2 class="font-headline-md text-headline-md uppercase font-bold text-text-primary tracking-tight">
                          {exp.company}
                        </h2>
                        
                        <!-- {직책} -->
                        <span class="font-label-mono text-label-mono uppercase font-bold text-text-primary">
                          {exp.role}
                        </span>

                        <!-- {시작-끝} -->
                        <span class="font-label-mono text-label-mono uppercase text-text-secondary font-code-block font-semibold">
                          {exp.period}
                        </span>                        
                      </div>

                      <!-- Auxiliary Metadata & Status -->
                      <div class="flex items-center gap-space-xs shrink-0 font-label-mono-xs text-label-mono-xs uppercase text-text-secondary">
                        <span class="border border-border-hairline px-2 py-0.5 bg-surface-subtle">
                          {exp.location}
                        </span>
                      </div>
                    </div>
                  </header>

                  <!-- PROJECTS CONTAINER -->
                  <div class="space-y-space-md">
                    {
                      exp.projects.map((project, pIdx) => (
                        <div class="p-space-md sm:p-space-md space-y-space-md transition-none">
                          
                          <!-- PROJECT HEADER: {프로젝트 제목} · {기간} -->
                          <div class="flex flex-col sm:flex-row sm:items-baseline pb-space-xs border-b border-border-hairline gap-space-xs">
                            <div class="flex flex-wrap items-baseline gap-x-space-sm gap-y-1">
                              <!-- Project Dot Marker -->
                              <svg class="w-2.5 h-2.5 text-accent-spec shrink-0" viewBox="0 0 10 10" fill="none">
                                <circle cx="5" cy="5" r="3.5" fill="currentColor"/>
                              </svg>                                
                              <!-- {프로젝트 제목} -->
                              <h3 class="font-headline-sm text-headline-sm uppercase font-bold text-text-primary tracking-tight">
                                {project.title}
                              </h3>
                            </div>
                            <!-- {기간} -->
                            <span class="font-code-block text-label-mono-xs uppercase text-text-secondary font-bold shrink-0">
                              {project.period}
                            </span>
                          </div>

                          <!-- PROJECT DESCRIPTION: {프로젝트 설명} -->
                          <div class="font-body-md text-body-md text-text-primary leading-relaxed border-l-2 border-border-hairline pl-space-sm py-0.5 bg-surface-canvas">
                            {project.description}
                          </div>

                          <!-- PROJECT TASK DETAILS: {프로젝트 작업 상세 설명} (n개를 표시하고 임의링크) -->
                          <div class="space-y-space-xs pt-space-xs">
                            <div class="flex items-center justify-between border-b border-border-subtle pb-1">
                              <span class="font-label-mono-xs text-label-mono-xs uppercase font-bold text-text-secondary tracking-wider">
                                [DETAILED TECHNICAL DELIVERABLES &amp; ACTIONS ({project.tasks.length})]
                              </span>
                              <span class="font-label-mono-xs text-label-mono-xs uppercase text-text-muted">
                                REF_LINK
                              </span>
                            </div>

                            <ul class="divide-y divide-border-subtle font-body-sm text-body-sm">
                              {project.tasks.map((task, tIdx) => (
                                <li class="py-space-xs flex flex-col md:flex-row md:items-baseline justify-between gap-space-xs hover:bg-surface-canvas px-1">
                                  <div class="flex items-start gap-space-sm flex-1 pr-space-md">
                                    <!-- Task bullet dot -->
                                    <svg class="w-1.5 h-1.5 text-text-secondary shrink-0 mt-1.5" viewBox="0 0 6 6" fill="none">
                                      <circle cx="3" cy="3" r="2.5" fill="currentColor"/>
                                    </svg>
                                    <!-- {프로젝트 작업 상세 설명} -->
                                    <span class="text-text-primary leading-relaxed font-normal">
                                      {task.description}
                                    </span>
                                  </div>

                                  <!-- 임의링크 (Arbitrary Link) -->
                                  {task.link && (
                                    <a
                                      href={task.link.href}
                                      class="inline-flex items-center gap-1.5 font-label-mono-xs text-label-mono-xs uppercase border border-border-hairline px-2 py-0.5 bg-surface-canvas hover:bg-surface-inverse hover:text-text-inverse transition-none select-none shrink-0 self-start md:self-auto group font-bold"
                                      title={`View documentation / artifact for ${task.link.label}`}
                                    >
                                      <span class="text-accent-spec">#</span>
                                      <span>{task.link.label}</span>
                                      <span class="group-hover:translate-x-0.5 transition-none text-text-secondary group-hover:text-text-inverse">→</span>
                                    </a>
                                  )}
                                </li>
                              ))}
                            </ul>
                          </div>

                          <!-- Tech Stack Footer Matrix -->
                          {project.techStack && (
                            <div class="flex flex-wrap items-center gap-space-xs pt-space-xs border-t border-border-subtle">
                              <span class="font-label-mono-xs text-label-mono-xs uppercase text-text-muted font-bold mr-1">
                                STACK_SPECS:
                              </span>
                              {project.techStack.map((tech) => (
                                <span class="font-code-block text-label-mono-xs border border-border-subtle px-1.5 py-0.5 bg-surface-canvas text-text-secondary uppercase">
                                  {tech}
                                </span>
                              ))}
                            </div>
                          )}

                        </div>
                      ))
                    }
                  </div>

                </div>
              </article>
            ))
          }
        </div>

        <!-- Timeline Termination Terminal (Left Aligned with the Line) -->
        <div class="relative pt-space-xl flex items-center gap-space-md">
          <div
            class="absolute -left-6 sm:-left-8 md:-left-10 flex items-center justify-center select-none"
            aria-hidden="true"
          >
            <div class="w-4 h-4 flex items-center justify-center">
              <svg class="w-3.5 h-3.5 text-text-secondary" viewBox="0 0 14 14" fill="none">
                <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5" fill="var(--color-surface-subtle)"/>
                <circle cx="7" cy="7" r="2" fill="currentColor"/>
              </svg>
            </div>
          </div>
          <div class="font-label-mono-xs text-label-mono-xs uppercase tracking-widest text-text-muted pl-1">
            // [END OF CHRONOLOGICAL ARCHIVE: FOUNDATIONAL YEARS 2016]
          </div>
        </div>

      </div>
    </section>
  </div>
</BaseLayout>

<script>
  function initResumeControls() {
    // 1. Category Filter Logic
    const filterBtns = document.querySelectorAll<HTMLButtonElement>(".timeline-filter-btn");
    const cards = document.querySelectorAll<HTMLElement>(".timeline-card");
    const searchInput = document.getElementById("resume-search") as HTMLInputElement | null;
    const printBtn = document.getElementById("print-cv-btn");

    if (!filterBtns.length || !cards.length) return;

    let activeFilter = "all";

    function updateVisibility() {
      const query = searchInput ? searchInput.value.toLowerCase().trim() : "";

      cards.forEach((card) => {
        const category = card.getAttribute("data-category");
        const text = card.innerText.toLowerCase();

        const matchesCategory = activeFilter === "all" || category === activeFilter;
        const matchesQuery = query === "" || text.includes(query);

        if (matchesCategory && matchesQuery) {
          card.style.display = "";
        } else {
          card.style.display = "none";
        }
      });
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        filterBtns.forEach((b) => {
          b.classList.remove("bg-surface-subtle", "text-text-primary", "font-bold", "border-text-primary");
          b.classList.add("bg-surface-canvas", "text-text-secondary", "border-transparent");
        });
        btn.classList.remove("bg-surface-canvas", "text-text-secondary", "border-transparent");
        btn.classList.add("bg-surface-subtle", "text-text-primary", "font-bold", "border-text-primary");

        activeFilter = btn.getAttribute("data-filter") || "all";
        updateVisibility();
      });
    });

    if (searchInput) {
      searchInput.addEventListener("input", updateVisibility);
    }

    if (printBtn) {
      printBtn.addEventListener("click", () => {
        window.print();
      });
    }
  }

  // Initialize on load and page transition
  initResumeControls();
  document.addEventListener("astro:after-swap", initResumeControls);
</script>
