---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import {
  WritingPostHeader,
  WritingPostFooter,
  MermaidModal,
} from "../../components/writing";
import "../../styles/markdown.css";

export async function getStaticPaths() {
  const posts = await getCollection("writing");
  return posts
    .filter((post) => Boolean(post.data.date && post.data.title && post.data.title !== "Untitled"))
    .map((post) => {
      // Extract filename uuid without directory and extension
      const uuid = post.id.split("/").pop()?.replace(/\.md$/, "") || post.id;
      return {
        params: { id: uuid },
        props: { post, uuid },
      };
    });
}

const { post, uuid } = Astro.props;
const { Content } = await render(post);

const backUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/writing`;
const dateFormatted = post.data.date ? post.data.date.replace(/-/g, ".") : "";
---

<BaseLayout
  title={`${post.data.title} // WRITING`}
  description={post.data.summary || post.data.title}
  currentPath="/writing"
>
  <div class="flex flex-col w-full bg-surface-canvas">
    <!-- Header with Back Button, Metadata, Title, Summary, Tags -->
    <WritingPostHeader
      title={post.data.title}
      date={dateFormatted}
      category={post.data.category}
      ref={post.data.ref}
      summary={post.data.summary}
      tags={post.data.tags}
      backUrl={backUrl}
      uuid={uuid}
    />

    <!-- Main Markdown Body -->
    <section class="flex justify-center bg-surface-canvas">
      <article class="markdown-body font-body-md text-body-md text-text-primary w-4xl">
        <Content />
      </article>
    </section>

    <!-- Footer Navigation & UUID -->
    <WritingPostFooter backUrl={backUrl} uuid={uuid} />
  </div>

  <!-- Interactive Pan & Zoom Modal for Diagrams -->
  <MermaidModal />

  <!-- Back Navigation & SVG Image Inlining Handlers -->
  <script>
    function setupBackNav() {
      const savedUrl = sessionStorage.getItem("writing_archive_url");
      document.querySelectorAll<HTMLAnchorElement>("[data-back-to-archive]").forEach((btn) => {
        if (savedUrl) {
          btn.href = savedUrl;
        }
        btn.addEventListener("click", (e) => {
          if (window.history.length > 1) {
            e.preventDefault();
            window.history.back();
          }
        });
      });
    }

    async function inlineSvgImages() {
      const images = document.querySelectorAll<HTMLImageElement>(
        ".markdown-body img[src*='.svg'], .markdown-body img[src*='f=svg']"
      );
      for (const img of Array.from(images)) {
        try {
          const res = await fetch(img.src);
          if (!res.ok) continue;
          const svgText = await res.text();
          const parser = new DOMParser();
          const doc = parser.parseFromString(svgText, "image/svg+xml");
          const svg = doc.querySelector("svg");
          if (!svg) continue;

          // Preserve attributes from img
          Array.from(img.attributes).forEach((attr) => {
            if (attr.name !== "src" && attr.name !== "loading" && attr.name !== "decoding") {
              if (attr.name === "class") {
                svg.classList.add(...attr.value.split(/\s+/).filter(Boolean));
              } else {
                svg.setAttribute(attr.name, attr.value);
              }
            }
          });

          if (!svg.getAttribute("aria-label") && img.alt) {
            svg.setAttribute("aria-label", img.alt);
          }

          img.replaceWith(svg);
        } catch (err) {
          console.error("Failed to inline SVG image:", err);
        }
      }
      document.dispatchEvent(new CustomEvent("images:inlined"));
    }

    setupBackNav();
    inlineSvgImages();
    document.addEventListener("astro:page-load", () => {
      setupBackNav();
      inlineSvgImages();
    });
    document.addEventListener("astro:after-swap", () => {
      setupBackNav();
      inlineSvgImages();
    });
  </script>
</BaseLayout>
