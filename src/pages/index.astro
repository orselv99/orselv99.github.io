---
import BaseLayout from "../layouts/BaseLayout.astro";
import { generateCryptoAttestation } from "../utils/cryptoAttestation";

const attestation = generateCryptoAttestation();

const recentUpdates = [
  {
    date: "2026.03.14",
    tag: "SYSTEMS",
    title: "The Illusion of Asynchronous Safety in Distributed Actors",
    href: "/writing",
  },
  {
    date: "2026.01.20",
    tag: "COMPILERS",
    title: "Compiling Dependent Types to Zero-Cost Machine Code",
    href: "/writing",
  },
  {
    date: "2025.11.28",
    tag: "KERNEL/IPC",
    title: "Deterministic Time-Travel Execution for Microkernel IPC",
    href: "/writing",
  },
  {
    date: "2025.09.15",
    tag: "THEORY",
    title: "Linear Logic as an Allocation Strategy for Embedded Kernels",
    href: "/writing",
  },
  {
    date: "2025.06.02",
    tag: "CONSENSUS",
    title: "High-Entropy Fault Injection in Raft Consensus Engines",
    href: "/writing",
  },
];
---

<BaseLayout
  title="KAI CHEN // SYSTEMS ARCHITECT & COMPILER RESEARCHER"
  description="Deterministic runtime systems, type-directed synthesis, and verified distributed state machines. Editorial Rationalism."
  currentPath="/"
>
  <div class="flex flex-col w-full bg-surface-canvas" id="philosophy">
    <!-- SECTION 1: MASTER IDENTITY & ENGINEERING DIRECTIVE -->
    <section class="space-y-space-lg bg-surface-canvas">
      <!-- Master Title & Headline & Social Contacts (Email, GitHub, LinkedIn) -->
      <div class="space-y-space-md border-b border-border-hairline pb-space-lg">
        <div class="space-y-space-sm">
          <div
            class="font-label-mono text-label-mono uppercase tracking-widest text-text-secondary"
          >
            // PRINCIPAL RESEARCHER &amp; FELLOW
          </div>
          <h1
            class="font-display-hero text-display-hero tracking-tighter text-text-primary leading-none select-none"
          >
            orseL
          </h1>
          <p
            class="font-headline-sm text-headline-sm uppercase tracking-tight text-text-primary pt-space-xs font-bold"
          >
            Systems Architect &amp; Compiler Researcher
          </p>
        </div>
        <div
          class="flex flex-wrap items-center justify-end gap-space-xs font-label-mono text-label-mono-xs uppercase"
        >
          <a
            href="mailto:orseLv99@gmail.com"
            class="inline-flex items-center gap-1.5 px-space-sm py-1 border border-border-hairline bg-surface-canvas hover:bg-surface-subtle text-text-primary transition-none select-none"
          >
            <svg
              class="w-3.5 h-3.5 text-text-primary"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect width="20" height="16" x="2" y="4" rx="0"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </a>
          <a
            href="https://github.com/orselv99"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-space-sm py-1 border border-border-hairline bg-surface-canvas hover:bg-surface-subtle text-text-primary transition-none select-none"
          >
            <svg
              class="w-3.5 h-3.5 text-text-primary fill-current"
              viewBox="0 0 24 24"
            >
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
              ></path>
            </svg>
          </a>
          <a
            href="https://www.linkedin.com/in/jeongho-ha-39377822a/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-space-sm py-1 border border-border-hairline bg-surface-canvas hover:bg-surface-subtle text-text-primary transition-none select-none"
          >
            <svg
              class="w-3.5 h-3.5 text-text-primary fill-current"
              viewBox="0 0 24 24"
            >
              <path
                d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.64 1.64 0 1 0 0 3.28 1.64 1.64 0 0 0 0-3.28z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Engineering Directive / Manifesto -->
      <div class="space-y-space-sm">
        <div
          class="font-label-mono-xs text-label-mono-xs uppercase tracking-widest text-text-secondary"
        >
          [THESIS / DIRECTIVE]
        </div>
        <blockquote
          class="font-body-lg text-body-lg text-text-primary leading-relaxed tracking-tight border-l-2 border-border-hairline pl-space-md py-space-xs max-w-4xl"
        >
          “Building deterministic runtime systems, type-directed synthesis, and
          verified distributed state machines. Rejecting accidental complexity
          in favor of mathematical rigor and structural clarity.”
        </blockquote>
      </div>
    </section>

    <!-- SECTION 2: CRYPTOGRAPHIC ATTESTATION & RECENT UPDATES -->
    <section
      class="py-space-lg md:py-space-xl space-y-space-lg bg-surface-canvas"
    >
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg">
        <!-- LEFT: Cryptographic Attestation (5 cols on desktop) -->
        <div class="lg:col-span-5 flex flex-col justify-between">
          <div
            class="border border-border-hairline p-space-md bg-surface-subtle space-y-space-sm h-full flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between">
                <span
                  class="font-label-mono-xs text-label-mono-xs uppercase tracking-wider text-text-secondary"
                >
                  CRYPTOGRAPHIC ATTESTATION
                </span>
                <span
                  class="font-code-block text-label-mono-xs text-text-primary font-bold"
                  >{attestation.commitId}</span
                >
              </div>
            </div>
            <div
              class="h-28 w-full flex items-center justify-center bg-surface-canvas border border-border-hairline px-space-md overflow-hidden"
            >
              <svg
                class="w-full h-10 text-text-primary opacity-80"
                viewBox="0 0 300 40"
                fill="none"
                stroke="currentColor"
              >
                <path
                  d={attestation.primaryPath}
                  stroke-width="1.5"
                  stroke-linecap="round"></path>
                <path
                  d={attestation.secondaryPath}
                  stroke-width="0.75"
                  stroke-dasharray="2 2"></path>
                {
                  attestation.markerDots.map((dot) => (
                    <circle
                      cx={dot.cx}
                      cy={dot.cy}
                      r={dot.r}
                      fill="currentColor"
                    />
                  ))
                }
              </svg>
            </div>
            <div class="flex flex-col gap-1 font-code-block text-label-mono-xs">
              <div
                class="break-all select-all text-right text-text-secondary leading-tight"
              >
                {attestation.sigHex}
              </div>
              <div
                class="text-right text-text-primary font-bold select-none leading-tight"
              >
                [VALIDATED: {attestation.commitDate}]
              </div>
            </div>
          </div>
        </div>

        <!-- RIGHT: Recent Updates & Dispatches (7 cols on desktop, max 5 items) -->
        <div
          class="lg:col-span-7 border border-border-hairline bg-surface-canvas h-full flex flex-col justify-between"
        >
          <div>
            <!-- Header Bar -->
            <div
              class="h-10 bg-surface-subtle px-space-md border-b border-border-hairline flex items-center justify-between"
            >
              <span
                class="font-label-mono-xs text-label-mono-xs uppercase font-semibold tracking-wider text-text-secondary"
              >
                RECENT UPDATES &amp; DISPATCHES
              </span>
            </div>

            <!-- List of 5 items from mock data -->
            <div
              class="divide-y divide-border-hairline font-label-mono text-label-mono"
            >
              {
                recentUpdates.map((item) => (
                  <a
                    href={item.href}
                    class="group grid grid-cols-1 sm:grid-cols-12 px-space-md py-space-sm items-baseline hover:bg-surface-subtle transition-none gap-y-1"
                  >
                    <div class="sm:col-span-3 font-code-block text-label-mono-xs text-text-secondary whitespace-nowrap">
                      {item.date}
                    </div>
                    <div class="sm:col-span-3 hidden sm:block">
                      <span class="font-label-mono-xs text-label-mono-xs uppercase border border-border-hairline px-1.5 py-0.5 bg-surface-subtle text-text-primary font-medium">
                        #{item.tag}
                      </span>
                    </div>
                    <div class="sm:col-span-5 font-body-sm text-body-sm font-semibold text-text-primary group-hover:underline truncate pr-space-xs">
                      {item.title}
                    </div>
                    <div class="sm:col-span-1 text-right font-label-mono text-label-mono font-bold text-text-primary group-hover:translate-x-0.5 transition-none">
                      →
                    </div>
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
