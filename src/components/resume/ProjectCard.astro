---
import type { Project } from "./types";

interface Props {
  project: Project;
}

const { project } = Astro.props;

function resolveTaskHref(href: string): string {
  if (!href || href === "#") return "#";
  if (href.startsWith("http://") || href.startsWith("https://")) return href;

  const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
  if (href.startsWith("/")) {
    return `${basePath}${href}`;
  }
  if (href.startsWith("writing/")) {
    return `${basePath}/${href}`;
  }
  return `${basePath}/writing/${href}`;
}
---

<div class="p-space-md sm:p-space-md space-y-space-md transition-none select-none cursor-default">
  <!-- 프로젝트 제목 · 기간 -->
  <div class="flex flex-col sm:flex-row sm:items-baseline pb-space-xs gap-space-xs">
    <!-- 제목 -->
    <div class="flex flex-wrap items-baseline gap-x-space-sm gap-y-1">
      <svg class="w-2.5 h-2.5 text-text-secondary shrink-0" viewBox="0 0 10 10" fill="none">
        <circle cx="5" cy="5" r="3.5" fill="currentColor"/>
      </svg>                                
      <h3 class="font-headline-sm text-headline-sm uppercase font-bold text-text-primary tracking-tight">
        {project.title}
      </h3>
    </div>
    <!-- 기간 -->
    <span class="font-code-block text-label-mono-xs uppercase text-text-secondary font-bold shrink-0">
      {project.period}
    </span>
  </div>

  <!-- 프로젝트 설명 -->
  <blockquote class="font-body-md text-body-md text-text-primary leading-relaxed border-l-2 border-border-hairline pl-space-sm py-0.5 bg-surface-canvas">
    {project.description}
  </blockquote>

  <!-- 프로젝트 작업 상세 설명 -->
  <div class="space-y-space-xs pt-space-xs">
    <ul class="space-y-space-xs font-body-sm text-body-sm">
      {project.tasks.map((task) => {
        const hasValidHref = Boolean(task.href && task.href !== "#");
        const taskHref = hasValidHref ? resolveTaskHref(task.href!) : null;
        return (
          <li
            class:list={[
              "group/task relative py-space-xs px-2.5 flex flex-col md:flex-row md:items-baseline justify-between gap-space-xs transition-all duration-200 ease-out hover:bg-surface-subtle border-l-2 border-transparent hover:border-accent-spec",
              hasValidHref && "cursor-pointer"
            ]}
            data-task-href={taskHref}
          >
            <!-- 작업 상세 설명 -->
            <div class="flex items-start gap-space-sm flex-1 pr-space-md">
              <svg class="w-1.5 h-1.5 text-text-secondary shrink-0 mt-1.5 transition-all duration-200 group-hover/task:text-accent-spec group-hover/task:scale-125" viewBox="0 0 6 6" fill="none">
                <circle cx="3" cy="3" r="2.5" fill="currentColor"/>
              </svg>
              <span class="text-text-primary leading-relaxed font-normal">
                {task.description}
              </span>
            </div>

            <!-- 게시물 링크 -->
            {task.href && (
              <a
                href={resolveTaskHref(task.href)}
                class="inline-flex items-center gap-1.5 font-label-mono-xs text-label-mono-xs uppercase border border-border-hairline px-2 py-0.5 bg-surface-canvas transition-all duration-150 select-none shrink-0 self-start md:self-auto font-bold cursor-pointer relative z-10"
                title={`View documentation / artifact for ${task.href}`}
              >
                <span>{task.href.length > 8 ? task.href.substring(0, 8) : task.href}</span>
                <span class="transition-transform duration-150 group-hover/task:translate-x-0.5 text-text-secondary hover:text-text-inverse">→</span>
              </a>
            )}
          </li>
        );
      })}
    </ul>
  </div>

  <!-- 기술스택 -->
  {project.techStack && (
    <div class="flex flex-wrap items-center gap-space-xs pt-space-md border-t border-border-subtle">
      <span class="font-label-mono-xs text-label-mono-xs uppercase text-text-muted font-bold mr-1">
        STACK_SPECS:
      </span>
      {project.techStack.map((tech) => (
        <span class="font-code-block text-label-mono-xs border border-border-subtle px-1.5 py-0.5 bg-surface-canvas text-text-secondary uppercase">
          {tech}
        </span>
      ))}
    </div>
  )}
</div>

<script>
  function setupTaskItemClicks() {
    document.addEventListener("click", (e) => {
      const taskLi = (e.target as HTMLElement)?.closest<HTMLElement>("li[data-task-href]");
      if (!taskLi) return;

      // If user clicked directly on an anchor or interactive element, let default behavior handle it
      if ((e.target as HTMLElement)?.closest("a")) return;

      const anchor = taskLi.querySelector<HTMLAnchorElement>("a[href]");
      if (anchor) {
        if (e.metaKey || e.ctrlKey) {
          window.open(anchor.href, "_blank");
        } else {
          anchor.click();
        }
      }
    });
  }

  setupTaskItemClicks();
</script>
