---
// Module 05: Chronology & Impact Matrix (Accordion)
---

<div class="p-gutter md:p-space-lg lg:p-space-xl space-y-space-md" id="experience">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-border-hairline pb-space-sm gap-space-xs">
    <div class="flex items-center space-x-space-sm">
      <span class="font-label-mono text-label-mono uppercase tracking-widest text-text-secondary font-bold">05 //</span>
      <span class="font-label-mono text-label-mono uppercase tracking-widest text-text-primary font-bold">CHRONOLOGY &amp; IMPACT MATRIX</span>
    </div>
    <div class="font-label-mono-xs text-label-mono-xs uppercase tracking-wider text-text-secondary">
      2017 — PRESENT
    </div>
  </div>

  <div class="border border-border-hairline divide-y divide-border-hairline bg-surface-canvas">
    <!-- Accordion 01 -->
    <div class="flex flex-col">
      <button
        class="w-full text-left p-space-md flex items-start justify-between bg-surface-canvas hover:bg-surface-subtle transition-none cursor-pointer select-none"
        type="button"
        data-accordion-target="exp-1"
      >
        <div class="space-y-space-xs pr-space-md">
          <div class="flex flex-wrap items-center gap-space-sm">
            <span class="font-headline-sm text-headline-sm uppercase font-bold text-text-primary">LEAD SYSTEMS ARCHITECT</span>
            <span class="font-label-mono-xs text-label-mono-xs border border-border-hairline px-1.5 py-0.5 bg-surface-subtle text-text-primary">HYPERION RESEARCH</span>
          </div>
          <div class="font-label-mono text-label-mono text-text-secondary">
            2022 — PRESENT // RUNTIME ARCHITECTURE GROUP
          </div>
        </div>
        <span class="font-code-block text-code-block font-bold text-text-primary" id="exp-1-icon">[−]</span>
      </button>
      <div class="px-space-md pb-space-md pt-0 bg-surface-subtle border-t border-border-hairline space-y-space-sm" id="exp-1">
        <p class="font-body-md text-body-md text-text-primary pt-space-sm leading-relaxed">
          Directing the core systems team in developing a high-throughput Byzantine fault-tolerant coordination layer. Re-engineered the zero-copy networking pipeline yielding a 65% reduction in latency variance across 4,000 nodes.
        </p>
        <div class="flex flex-wrap gap-space-xs pt-space-xs font-label-mono-xs text-label-mono-xs">
          <span class="border border-border-hairline px-2 py-0.5 bg-surface-canvas text-text-primary">[RFC-018: CONSENSUS BOUNDS]</span>
          <span class="border border-border-hairline px-2 py-0.5 bg-surface-canvas text-text-primary">[EBPF TELEMETRY MESH]</span>
          <span class="border border-border-hairline px-2 py-0.5 bg-surface-canvas text-text-primary">[VERIFIED DISK LOGGING]</span>
        </div>
      </div>
    </div>

    <!-- Accordion 02 -->
    <div class="flex flex-col">
      <button
        class="w-full text-left p-space-md flex items-start justify-between bg-surface-canvas hover:bg-surface-subtle transition-none cursor-pointer select-none"
        type="button"
        data-accordion-target="exp-2"
      >
        <div class="space-y-space-xs pr-space-md">
          <div class="flex flex-wrap items-center gap-space-sm">
            <span class="font-headline-sm text-headline-sm uppercase font-bold text-text-primary">SENIOR STAFF ENGINEER</span>
            <span class="font-label-mono-xs text-label-mono-xs border border-border-hairline px-1.5 py-0.5 bg-surface-subtle text-text-primary">VECTOR LABS</span>
          </div>
          <div class="font-label-mono text-label-mono text-text-secondary">
            2019 — 2022 // COMPILER INFRASTRUCTURE
          </div>
        </div>
        <span class="font-code-block text-code-block font-bold text-text-primary" id="exp-2-icon">[+]</span>
      </button>
      <div class="hidden px-space-md pb-space-md pt-0 bg-surface-subtle border-t border-border-hairline space-y-space-sm" id="exp-2">
        <p class="font-body-md text-body-md text-text-primary pt-space-sm leading-relaxed">
          Architected the JIT compilation engine for a distributed streaming analytics pipeline. Introduced custom LLVM target optimization passes that eliminated redundant bounds checks in inner computational loops.
        </p>
        <div class="flex flex-wrap gap-space-xs pt-space-xs font-label-mono-xs text-label-mono-xs">
          <span class="border border-border-hairline px-2 py-0.5 bg-surface-canvas text-text-primary">[LLVM BACKEND EMISSION]</span>
          <span class="border border-border-hairline px-2 py-0.5 bg-surface-canvas text-text-primary">[STREAM PARTITION ENGINE]</span>
          <span class="border border-border-hairline px-2 py-0.5 bg-surface-canvas text-text-primary">[SUB-MS PIPELINE]</span>
        </div>
      </div>
    </div>

    <!-- Accordion 03 -->
    <div class="flex flex-col">
      <button
        class="w-full text-left p-space-md flex items-start justify-between bg-surface-canvas hover:bg-surface-subtle transition-none cursor-pointer select-none"
        type="button"
        data-accordion-target="exp-3"
      >
        <div class="space-y-space-xs pr-space-md">
          <div class="flex flex-wrap items-center gap-space-sm">
            <span class="font-headline-sm text-headline-sm uppercase font-bold text-text-primary">CORE CONTRIBUTOR</span>
            <span class="font-label-mono-xs text-label-mono-xs border border-border-hairline px-1.5 py-0.5 bg-surface-subtle text-text-primary">RUST COMPILER WG</span>
          </div>
          <div class="font-label-mono text-label-mono text-text-secondary">
            2017 — 2019 // TYPE SYSTEM &amp; POLONIUS
          </div>
        </div>
        <span class="font-code-block text-code-block font-bold text-text-primary" id="exp-3-icon">[+]</span>
      </button>
      <div class="hidden px-space-md pb-space-md pt-0 bg-surface-subtle border-t border-border-hairline space-y-space-sm" id="exp-3">
        <p class="font-body-md text-body-md text-text-primary pt-space-sm leading-relaxed">
          Contributed to the non-lexical lifetimes (NLL) analysis engine and Chalk trait-solver unification. Authored high-precision diagnostic traces for complex higher-ranked trait bounds (HRTBs).
        </p>
        <div class="flex flex-wrap gap-space-xs pt-space-xs font-label-mono-xs text-label-mono-xs">
          <span class="border border-border-hairline px-2 py-0.5 bg-surface-canvas text-text-primary">[POLONIUS BORROW CHECKER]</span>
          <span class="border border-border-hairline px-2 py-0.5 bg-surface-canvas text-text-primary">[CHALK TRAIT SOLVER]</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Accordion Toggle Handler
  document.querySelectorAll<HTMLButtonElement>('[data-accordion-target]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-accordion-target');
      if (!targetId) return;

      const panel = document.getElementById(targetId);
      const icon = document.getElementById(`${targetId}-icon`);
      if (!panel || !icon) return;

      const isHidden = panel.classList.contains('hidden');
      if (isHidden) {
        panel.classList.remove('hidden');
        icon.textContent = '[−]';
      } else {
        panel.classList.add('hidden');
        icon.textContent = '[+]';
      }
    });
  });
</script>
