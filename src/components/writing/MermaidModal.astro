---
// Mermaid Diagram Inspector Modal with Pan & Zoom
---

<!-- Mermaid Zoom / Detail Inspector Modal -->
<div
  id="mermaid-modal"
  class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-xs flex flex-col items-center justify-center p-3 sm:p-6 md:p-8 select-none"
  aria-hidden="true"
  role="dialog"
>
  <div
    class="relative w-[95vw] max-w-6xl h-[88vh] flex flex-col bg-surface-canvas border border-border-hairline shadow-2xl overflow-hidden"
    id="mermaid-modal-content"
  >
    <!-- Modal Header -->
    <div class="h-10 px-4 bg-surface-subtle border-b border-border-hairline flex items-center justify-between font-label-mono-xs text-label-mono-xs uppercase text-text-primary shrink-0">
      <div class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 bg-accent-spec inline-block"></span>
        <span class="font-bold tracking-wider">DIAGRAM</span>
      </div>

      <div class="flex items-center gap-2">
        <!-- Zoom Controls -->
        <div class="flex items-center border border-border-hairline bg-surface-canvas">
          <button
            id="mermaid-zoom-out"
            type="button"
            class="px-2.5 py-0.5 hover:bg-surface-subtle border-r border-border-hairline text-text-primary font-bold cursor-pointer"
            title="Zoom Out"
          >
            -
          </button>
          <span id="mermaid-zoom-level" class="px-2.5 py-0.5 text-text-secondary font-code-block">
            100%
          </span>
          <button
            id="mermaid-zoom-in"
            type="button"
            class="px-2.5 py-0.5 hover:bg-surface-subtle border-l border-border-hairline text-text-primary font-bold cursor-pointer"
            title="Zoom In"
          >
            +
          </button>
          <button
            id="mermaid-zoom-reset"
            type="button"
            class="px-2 py-0.5 hover:bg-surface-subtle border-l border-border-hairline text-text-secondary hover:text-text-primary cursor-pointer"
            title="Reset Zoom (100%)"
          >
            RESET
          </button>
        </div>

        <!-- Close Button -->
        <button
          id="mermaid-modal-close"
          type="button"
          class="px-2.5 py-0.5 border border-border-hairline bg-surface-canvas hover:bg-accent-spec hover:text-text-inverse text-text-primary font-bold transition-none cursor-pointer"
          title="Close (ESC)"
        >
          [CLOSE ✕]
        </button>
      </div>
    </div>

    <!-- Modal Body: Infinite 2D Pan & Zoom Canvas -->
    <div
      id="mermaid-modal-viewport"
      class="relative flex-1 overflow-hidden flex items-center justify-center bg-surface-card cursor-grab select-none touch-none"
    >
      <div
        id="mermaid-modal-target"
        class="flex justify-center items-center pointer-events-none will-change-transform"
      >
        <!-- Cloned SVG will be inserted here -->
      </div>
    </div>
  </div>
</div>

<script>
  let renderCount = 0;
  let currentZoom = 1;
  let baseWidth = 850;
  let panX = 0;
  let panY = 0;
  let wasDragged = false;
  let backdropMouseDown = false;

  function updateTransform() {
    const target = document.getElementById("mermaid-modal-target");
    if (target) {
      target.style.transform = `translate3d(${panX}px, ${panY}px, 0)`;
    }
  }

  function clampPan() {
    const viewport = document.getElementById("mermaid-modal-viewport");
    const targetSvg = document.querySelector<SVGElement>("#mermaid-modal-target svg");
    if (!viewport || !targetSvg) return;

    const vpW = viewport.clientWidth;
    const vpH = viewport.clientHeight;
    if (vpW <= 0 || vpH <= 0) return;

    const rect = targetSvg.getBoundingClientRect();
    const svgW = rect.width;
    const svgH = rect.height;
    if (svgW <= 0 || svgH <= 0) return;

    const margin = 40;

    // Horizontal clamping: restrict so diagram doesn't exit the window bounds
    if (svgW > vpW) {
      const maxLimitX = (svgW - vpW) / 2 + margin;
      panX = Math.max(-maxLimitX, Math.min(maxLimitX, panX));
    } else {
      const maxLimitX = Math.max(0, (vpW - svgW) / 2);
      panX = Math.max(-maxLimitX, Math.min(maxLimitX, panX));
    }

    // Vertical clamping: restrict so diagram doesn't exit the window bounds
    if (svgH > vpH) {
      const maxLimitY = (svgH - vpH) / 2 + margin;
      panY = Math.max(-maxLimitY, Math.min(maxLimitY, panY));
    } else {
      const maxLimitY = Math.max(0, (vpH - svgH) / 2);
      panY = Math.max(-maxLimitY, Math.min(maxLimitY, panY));
    }
  }

  function updateZoom(newZoom: number) {
    currentZoom = Math.max(0.3, Math.min(4.0, Math.round(newZoom * 100) / 100));
    const targetSvg = document.querySelector<SVGElement>("#mermaid-modal-target svg");
    const label = document.getElementById("mermaid-zoom-level");
    if (targetSvg) {
      targetSvg.style.width = `${Math.round(baseWidth * currentZoom)}px`;
      targetSvg.style.height = "auto";
      targetSvg.style.maxWidth = "none";
    }
    if (label) {
      label.textContent = `${Math.round(currentZoom * 100)}%`;
    }
    clampPan();
    updateTransform();
  }

  function openMermaidModal(chartEl: HTMLElement) {
    const modal = document.getElementById("mermaid-modal");
    const target = document.getElementById("mermaid-modal-target");
    const svgEl = chartEl.querySelector("svg");
    if (!modal || !target || !svgEl) return;

    // Clone SVG for full natural resolution
    const clone = svgEl.cloneNode(true) as SVGElement;
    clone.style.maxWidth = "none";
    clone.style.height = "auto";
    clone.removeAttribute("width");
    clone.removeAttribute("height");

    // Natural width calculation based on viewBox
    const vb = svgEl.viewBox?.baseVal;
    baseWidth = vb && vb.width > 0 ? Math.max(vb.width, 850) : 900;
    clone.style.width = `${baseWidth}px`;

    target.innerHTML = "";
    target.appendChild(clone);

    modal.classList.remove("hidden");
    document.body.style.overflow = "hidden";

    // Reset pan & zoom to center
    panX = 0;
    panY = 0;
    currentZoom = 1;
    updateZoom(1);
    clampPan();
    updateTransform();
  }

  function closeMermaidModal() {
    const modal = document.getElementById("mermaid-modal");
    const target = document.getElementById("mermaid-modal-target");
    if (!modal) return;
    modal.classList.add("hidden");
    if (target) target.innerHTML = "";
    document.body.style.overflow = "";
    document.body.style.cursor = "";
  }

  // Setup Drag to Pan on Viewport
  function setupDragPanning() {
    const viewport = document.getElementById("mermaid-modal-viewport");
    if (!viewport) return;

    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let initialPanX = 0;
    let initialPanY = 0;

    viewport.onmousedown = (e: MouseEvent) => {
      if (e.button !== 0) return; // Left click only
      isDragging = true;
      wasDragged = false;
      viewport.style.cursor = "grabbing";
      document.body.style.cursor = "grabbing";
      startX = e.clientX;
      startY = e.clientY;
      initialPanX = panX;
      initialPanY = panY;
      e.preventDefault();
    };

    window.addEventListener("mousemove", (e: MouseEvent) => {
      if (!isDragging) return;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (Math.hypot(dx, dy) > 4) {
        wasDragged = true;
      }
      panX = initialPanX + dx;
      panY = initialPanY + dy;

      const prevX = panX;
      const prevY = panY;
      clampPan();

      if (panX !== prevX) {
        initialPanX += panX - prevX;
      }
      if (panY !== prevY) {
        initialPanY += panY - prevY;
      }

      updateTransform();
    });

    window.addEventListener("mouseup", () => {
      if (isDragging) {
        isDragging = false;
        viewport.style.cursor = "grab";
        document.body.style.cursor = "";
        setTimeout(() => {
          wasDragged = false;
        }, 80);
      }
    });

    // Mousewheel: Ctrl+Wheel to Zoom, regular Wheel to Pan
    viewport.onwheel = (e: WheelEvent) => {
      e.preventDefault();
      e.stopPropagation();
      if (e.ctrlKey || e.metaKey) {
        const delta = e.deltaY < 0 ? 0.15 : -0.15;
        updateZoom(currentZoom + delta);
      } else {
        if (e.shiftKey) {
          panX -= e.deltaY;
        } else {
          panX -= e.deltaX;
          panY -= e.deltaY;
        }
        clampPan();
        updateTransform();
      }
    };
  }

  function setupModalControls() {
    const modal = document.getElementById("mermaid-modal");
    if (!modal || modal.dataset.controlsInitialized === "true") return;
    modal.dataset.controlsInitialized = "true";

    const closeBtn = document.getElementById("mermaid-modal-close");
    const zoomInBtn = document.getElementById("mermaid-zoom-in");
    const zoomOutBtn = document.getElementById("mermaid-zoom-out");
    const zoomResetBtn = document.getElementById("mermaid-zoom-reset");

    closeBtn?.addEventListener("click", closeMermaidModal);
    zoomInBtn?.addEventListener("click", () => updateZoom(currentZoom + 0.25));
    zoomOutBtn?.addEventListener("click", () => updateZoom(currentZoom - 0.25));
    zoomResetBtn?.addEventListener("click", () => {
      panX = 0;
      panY = 0;
      updateZoom(1);
    });

    // Backdrop click handling:
    // Only close if mousedown was explicitly on the modal backdrop,
    // mouseup is on the backdrop, AND no drag took place!
    modal.addEventListener("mousedown", (e: MouseEvent) => {
      backdropMouseDown = (e.target === modal);
    });

    modal.addEventListener("click", (e: MouseEvent) => {
      if (backdropMouseDown && e.target === modal && !wasDragged) {
        closeMermaidModal();
      }
      backdropMouseDown = false;
    });

    // Prevent default browser zoom on Ctrl+Wheel anywhere inside the modal dialog
    modal.addEventListener(
      "wheel",
      (e: WheelEvent) => {
        if (e.ctrlKey || e.metaKey) {
          e.preventDefault();
          const delta = e.deltaY < 0 ? 0.15 : -0.15;
          updateZoom(currentZoom + delta);
        }
      },
      { passive: false }
    );

    setupDragPanning();
  }

  // Global Key listeners for ESC and Zoom shortcuts
  window.addEventListener(
    "keydown",
    (e: KeyboardEvent) => {
      const modal = document.getElementById("mermaid-modal");
      if (!modal || modal.classList.contains("hidden")) return;

      if (e.key === "Escape") {
        closeMermaidModal();
        return;
      }

      if (e.ctrlKey || e.metaKey) {
        if (e.key === "=" || e.key === "+" || e.key === "Add") {
          e.preventDefault();
          updateZoom(currentZoom + 0.25);
        } else if (e.key === "-" || e.key === "Subtract") {
          e.preventDefault();
          updateZoom(currentZoom - 0.25);
        } else if (e.key === "0") {
          e.preventDefault();
          panX = 0;
          panY = 0;
          updateZoom(1);
        }
      }
    },
    { passive: false }
  );

  // Delegated click on any .mermaid-chart in document
  document.addEventListener("click", (e) => {
    const chart = (e.target as HTMLElement)?.closest<HTMLElement>(".mermaid-chart");
    if (chart) {
      openMermaidModal(chart);
    }
  });

  // Diagram rendering logic
  async function renderMermaidCharts() {
    // Ensure all markdown codeblocks have data-language attribute for badge display
    document.querySelectorAll<HTMLElement>('.markdown-body pre:not([data-language]) code[class*="language-"]').forEach((code) => {
      const match = code.className.match(/language-([a-zA-Z0-9_-]+)/);
      if (match && match[1] && code.parentElement) {
        code.parentElement.setAttribute("data-language", match[1]);
      }
    });

    const preList = Array.from(
      document.querySelectorAll<HTMLElement>(
        '.markdown-body pre[data-language="mermaid"], .markdown-body pre[data-language="sequenceDiagram"], .markdown-body pre[data-language="sequencediagram"], .markdown-body pre:has(code.language-mermaid), .markdown-body pre:has(code.language-sequenceDiagram), .markdown-body pre:has(code.language-sequencediagram)'
      )
    );

    document.querySelectorAll<HTMLElement>(".markdown-body pre").forEach((pre) => {
      if (preList.includes(pre)) return;
      const text = (pre.textContent || "").trim();
      if (
        text.startsWith("graph ") ||
        text.startsWith("graph\n") ||
        text.startsWith("flowchart") ||
        text.startsWith("sequenceDiagram") ||
        text.startsWith("classDiagram") ||
        text.startsWith("stateDiagram") ||
        text.startsWith("erDiagram") ||
        text.startsWith("gantt") ||
        text.startsWith("pie") ||
        text.startsWith("gitGraph") ||
        text.startsWith("mindmap") ||
        text.startsWith("timeline")
      ) {
        preList.push(pre);
      }
    });

    const existingCharts = document.querySelectorAll<HTMLElement>(
      ".mermaid-chart[data-raw-mermaid]"
    );

    if (preList.length === 0 && existingCharts.length === 0) {
      return;
    }

    const mermaid = (await import("mermaid")).default;
    const isDark = document.documentElement.classList.contains("dark");

    mermaid.initialize({
      startOnLoad: false,
      theme: isDark ? "dark" : "neutral",
      themeVariables: isDark
        ? {
            darkMode: true,
            background: "transparent",
            primaryColor: "#202227",
            primaryBorderColor: "#3a3d47",
            primaryTextColor: "#ededed",
            lineColor: "#9b9ea8",
            textColor: "#ededed",
            fontFamily: "Inter, sans-serif",
            fontSize: "13px",
            // Sequence Diagram specific theme tokens
            actorBkg: "#202227",
            actorBorder: "#3a3d47",
            actorTextColor: "#ededed",
            actorLineColor: "#4b505c",
            signalColor: "#9b9ea8",
            signalTextColor: "#ededed",
            labelBoxBkgColor: "#202227",
            labelBoxBorderColor: "#3a3d47",
            labelTextColor: "#ededed",
            loopTextColor: "#ededed",
            noteBkgColor: "#181a1f",
            noteBorderColor: "#3a3d47",
            noteTextColor: "#ededed",
            activationBkgColor: "#2d3139",
            activationBorderColor: "#ea580c",
            sequenceNumberColor: "#ffffff",
          }
        : {
            darkMode: false,
            background: "transparent",
            primaryColor: "#e8e5de",
            primaryBorderColor: "#2d3139",
            primaryTextColor: "#1c1d22",
            lineColor: "#2d3139",
            textColor: "#1c1d22",
            fontFamily: "Inter, sans-serif",
            fontSize: "13px",
            // Sequence Diagram specific theme tokens
            actorBkg: "#ffffff",
            actorBorder: "#2d3139",
            actorTextColor: "#1c1d22",
            actorLineColor: "#c2c0b8",
            signalColor: "#2d3139",
            signalTextColor: "#1c1d22",
            labelBoxBkgColor: "#f5f4ef",
            labelBoxBorderColor: "#2d3139",
            labelTextColor: "#1c1d22",
            loopTextColor: "#1c1d22",
            noteBkgColor: "#f5f4ef",
            noteBorderColor: "#2d3139",
            noteTextColor: "#1c1d22",
            activationBkgColor: "#e8e5de",
            activationBorderColor: "#2d3139",
            sequenceNumberColor: "#ffffff",
          },
      sequence: {
        diagramMarginX: 60,
        diagramMarginY: 50,
        actorMargin: 100,
        width: 170,
        height: 60,
        boxMargin: 38,
        boxTextMargin: 10,
        noteMargin: 18,
        messageMargin: 65,
        mirrorActors: false,
        bottomMarginAdj: 1,
        useMaxWidth: true,
        autonumber: true,
        actorFontSize: 13,
        actorFontFamily: "Inter, sans-serif",
        noteFontSize: 12,
        noteFontFamily: "Inter, sans-serif",
        messageFontSize: 12,
        messageFontFamily: "Inter, sans-serif",
      },
      securityLevel: "loose",
    });

    // Post-processing to enhance sequence diagram alt & else control structures
    function enhanceSequenceLoops(container: HTMLElement) {
      const controlGroups = container.querySelectorAll<SVGGElement>(
        'g[data-et="control-structure"], g:has(> polygon.labelBox)'
      );

      controlGroups.forEach((group) => {
        const labelBox = group.querySelector<SVGPolygonElement>("polygon.labelBox");
        const labelText = group.querySelector<SVGTextElement>("text.labelText");
        const loopText = group.querySelector<SVGTextElement>("text.loopText");

        if (!labelBox || !labelText) return;

        const labelContent = labelText.textContent?.trim().toLowerCase();
        if (labelContent !== "alt" && labelContent !== "opt") return;

        // Extract coordinates from labelBox points: "x1,y1 x2,y2 x3,y3 x4,y4 x5,y5"
        const pointsStr = labelBox.getAttribute("points") || "";
        const pointPairs = pointsStr
          .trim()
          .split(/\s+/)
          .map((p) => p.split(",").map(Number));

        if (pointPairs.length < 5 || isNaN(pointPairs[0][0]) || isNaN(pointPairs[0][1])) return;

        const startX = pointPairs[0][0];
        const startY = pointPairs[0][1];
        const boxW = pointPairs[1][0] - startX;
        const boxH = pointPairs[4][1] - startY;

        // 1. Move loopText (e.g. "[테스트 통과 (OK)]") to top-left next to the "alt" badge
        if (loopText) {
          const targetX = startX + boxW + 12;
          const targetY = parseFloat(labelText.getAttribute("y") || String(startY + boxH / 2));

          loopText.setAttribute("x", String(targetX));
          loopText.setAttribute("y", String(targetY));
          loopText.setAttribute("text-anchor", "start");
          loopText.setAttribute("dominant-baseline", "middle");
          loopText.setAttribute("alignment-baseline", "middle");

          loopText.querySelectorAll("tspan").forEach((tspan) => {
            tspan.setAttribute("x", String(targetX));
            tspan.setAttribute("text-anchor", "start");
          });
        }

        if (labelContent === "alt") {
          // 2. Locate dashed dividing lines representing "else" sections
          const allLines = Array.from(group.querySelectorAll<SVGLineElement>("line.loopLine"));
          const dividerLines = allLines.filter((line) => {
            const style = line.getAttribute("style") || "";
            const dash = line.getAttribute("stroke-dasharray") || "";
            return (
              style.includes("stroke-dasharray") ||
              Boolean(line.style.strokeDasharray) ||
              dash.length > 0
            );
          });

          const sectionTitles = Array.from(
            group.querySelectorAll<SVGTextElement>("text.sectionTitle")
          );

          dividerLines.forEach((divLine, idx) => {
            const divX = parseFloat(divLine.getAttribute("x1") || String(startX));
            const divY = parseFloat(divLine.getAttribute("y1") || "0");
            if (isNaN(divY) || divY === 0) return;

            // Mermaid polygon badge generator (pentagon with folded-corner notch)
            const cut = 7;
            const genPoints = (x: number, y: number, w: number, h: number) =>
              `${x},${y} ${x + w},${y} ${x + w},${y + h - cut} ${x + w - cut * 1.2},${y + h} ${x},${y + h}`;

            // Create "else" badge box polygon
            const elseBox = labelBox.cloneNode(true) as SVGPolygonElement;
            elseBox.setAttribute("points", genPoints(divX, divY, boxW, boxH));
            elseBox.classList.add("elseLabelBox");
            group.appendChild(elseBox);

            // Create "else" badge text
            const elseText = labelText.cloneNode(true) as SVGTextElement;
            elseText.textContent = "else";
            elseText.setAttribute("x", String(divX + boxW / 2));
            elseText.setAttribute("y", String(divY + boxH / 2));
            elseText.setAttribute("text-anchor", "middle");
            elseText.setAttribute("dominant-baseline", "middle");
            elseText.setAttribute("alignment-baseline", "middle");
            group.appendChild(elseText);

            // Adjust divider line so dashed line starts cleanly after the badge
            divLine.setAttribute("x1", String(divX + boxW));

            // Position corresponding sectionTitle (e.g. "[버그 발견 (NG)]") next to "else" badge
            const secTitle = sectionTitles[idx];
            if (secTitle) {
              const targetX = divX + boxW + 12;
              const targetY = divY + boxH / 2;

              secTitle.setAttribute("x", String(targetX));
              secTitle.setAttribute("y", String(targetY));
              secTitle.setAttribute("text-anchor", "start");
              secTitle.setAttribute("dominant-baseline", "middle");
              secTitle.setAttribute("alignment-baseline", "middle");

              secTitle.querySelectorAll("tspan").forEach((tspan) => {
                tspan.setAttribute("x", String(targetX));
                tspan.setAttribute("text-anchor", "start");
              });
            }
          });
        }
      });
    }

    // Post-processing to fix Mermaid sequence diagram actor lifelines when mirrorActors: false
    // Mermaid defaults initial lifeline y2 to 2000 (2e3) and only updates it when mirrorActors is true.
    // For diagrams taller than 2000px, lifelines prematurely stop at y2=2000 (often around step 17).
    function fixSequenceLifelines(container: HTMLElement) {
      const svg = container.querySelector("svg");
      if (!svg) return;

      const actorLines = Array.from(svg.querySelectorAll<SVGLineElement>("line")).filter((line) => {
        const id = line.getAttribute("id") || "";
        const cls = line.getAttribute("class") || "";
        const et = line.getAttribute("data-et") || "";
        const x1 = line.getAttribute("x1");
        const x2 = line.getAttribute("x2");
        const isVertical = x1 !== null && x1 === x2;
        return (
          isVertical &&
          (/^actor\d+$/.test(id) || cls.includes("actor-line") || et === "life-line")
        );
      });

      if (actorLines.length === 0) return;

      // Determine true bottom bound of diagram content
      const vb = svg.viewBox?.baseVal;
      let bottomY = 0;
      if (vb && vb.height > 0) {
        // In Mermaid, viewBox Y min is -diagramMarginY (-50), and height is boxHeight + 2*diagramMarginY
        // The bottom-most content ends around: vb.y + vb.height - diagramMarginY
        bottomY = vb.y + vb.height - 50;
      }

      // Also compute maximum Y coordinate among all message lines, loop lines, notes, texts
      let maxContentY = 0;
      const contentElements = svg.querySelectorAll<SVGElement>(
        "line.messageLine0, line.messageLine1, line.loopLine, rect.note, rect.actor, text, g[data-et='control-structure']"
      );
      contentElements.forEach((el) => {
        if (actorLines.includes(el as any)) return;
        const y1 = parseFloat(el.getAttribute("y1") || "0");
        const y2 = parseFloat(el.getAttribute("y2") || "0");
        const y = parseFloat(el.getAttribute("y") || "0");
        const h = parseFloat(el.getAttribute("height") || "0");
        const maxY = Math.max(y1, y2, y + h);
        if (maxY > maxContentY && maxY < 100000) {
          maxContentY = maxY;
        }
      });

      // Target Y: ensure lifelines cleanly extend through all steps down to the bottom
      const targetY = Math.max(bottomY, maxContentY + 15);

      if (targetY > 0) {
        actorLines.forEach((line) => {
          const currentY2 = parseFloat(line.getAttribute("y2") || "0");
          if (currentY2 < targetY) {
            line.setAttribute("y2", String(Math.round(targetY)));
          }
        });
      }
    }

    // Re-render existing charts if theme changed
    for (const container of Array.from(existingCharts)) {
      const rawCode = container.getAttribute("data-raw-mermaid");
      if (!rawCode) continue;
      try {
        const id = `mermaid-svg-${Date.now()}-${++renderCount}`;
        const { svg } = await mermaid.render(id, rawCode);
        container.innerHTML = svg;
        enhanceSequenceLoops(container);
        fixSequenceLifelines(container);
      } catch (err) {
        console.error("Failed to re-render Mermaid diagram:", err);
      }
    }

    // Render new pre blocks
    for (const pre of preList) {
      let rawCode = (pre.textContent || "").trim();
      if (!rawCode) continue;

      const lang = (pre.getAttribute("data-language") || "").toLowerCase();
      if (
        (lang === "sequencediagram" || lang === "sequence") &&
        !rawCode.startsWith("sequenceDiagram")
      ) {
        rawCode = "sequenceDiagram\n" + rawCode;
      }

      try {
        const id = `mermaid-svg-${Date.now()}-${++renderCount}`;
        const { svg } = await mermaid.render(id, rawCode);

        const container = document.createElement("div");
        container.className = "mermaid-chart";
        container.setAttribute("data-raw-mermaid", rawCode);
        container.innerHTML = svg;
        enhanceSequenceLoops(container);
        fixSequenceLifelines(container);

        pre.replaceWith(container);
      } catch (err) {
        console.error("Failed to render Mermaid diagram:", err);
      }
    }
  }

  // Initialize
  renderMermaidCharts();
  setupModalControls();

  document.addEventListener("astro:page-load", () => {
    renderMermaidCharts();
    setupModalControls();
  });

  document.addEventListener("astro:after-swap", () => {
    renderMermaidCharts();
    setupModalControls();
  });

  // Theme observer
  let lastTheme = document.documentElement.classList.contains("dark");
  const observer = new MutationObserver(() => {
    const currentTheme = document.documentElement.classList.contains("dark");
    if (currentTheme !== lastTheme) {
      lastTheme = currentTheme;
      renderMermaidCharts();
    }
  });
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
</script>
