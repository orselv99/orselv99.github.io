---
import type { BuildSignature } from "../../utils/buildSignature";
import { generateBuildSignature } from "../../utils/buildSignature";

interface Props {
  signature?: BuildSignature;
  class?: string;
}

const {
  signature = generateBuildSignature(),
  class: className = "",
} = Astro.props;
---

<div class:list={["flex flex-col justify-between", className]}>
  <div
    class="border border-border-hairline p-space-md bg-surface-subtle space-y-space-sm h-full flex flex-col justify-between"
  >
    <div>
      <div class="flex items-center justify-between">
        <span
          class="font-label-mono-xs text-label-mono-xs uppercase tracking-wider text-text-secondary"
        >
          BUILD SIGNATURE
        </span>
        <span
          class="font-code-block text-label-mono-xs text-text-primary font-bold"
        >
          {signature.commitId}
        </span>
      </div>
    </div>
    <div
      class="h-28 w-full flex items-center justify-center bg-surface-canvas border border-border-hairline px-space-md overflow-hidden"
    >
      <svg
        class="w-full h-10 text-text-primary opacity-80"
        viewBox="0 0 300 40"
        fill="none"
        stroke="currentColor"
      >
        <path
          d={signature.primaryPath}
          stroke-width="1.5"
          stroke-linecap="round"
        />
        <path
          d={signature.secondaryPath}
          stroke-width="0.75"
          stroke-dasharray="2 2"
        />
        {
          signature.markerDots.map((dot) => (
            <circle
              cx={dot.cx}
              cy={dot.cy}
              r={dot.r}
              fill="currentColor"
            />
          ))
        }
      </svg>
    </div>
    <div class="flex flex-col gap-1 font-code-block text-label-mono-xs">
      <div
        class="break-all select-all text-right text-text-secondary leading-tight"
      >
        {signature.sigHex}
      </div>
      <div
        class="text-right text-text-primary font-bold select-none leading-tight"
      >
        [BUILD: {signature.commitDate}]
      </div>
    </div>
  </div>
</div>
