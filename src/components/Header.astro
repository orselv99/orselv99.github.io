---
interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const navItems = [
  { label: "01. HOME", href: `${basePath}/`, id: "home" },
  { label: "02. RESUME", href: `${basePath}/resume`, id: "resume" },
  { label: "03. ARTIFACTS", href: `${basePath}/artifacts`, id: "artifacts" },
  { label: "04. WRITING", href: `${basePath}/writing`, id: "writing" },
];
---

<header class="top-0 z-50 w-full bg-surface-canvas">
  <div class="h-10 w-full flex items-center justify-between bg-surface-canvas overflow-x-auto">
    <!-- GNB Navigation -->
    <nav class="flex items-center gap-space-md md:gap-space-lg h-full shrink-0">
      {
        navItems.map((item) => {
          const normalizedCurrent = currentPath.replace(/\/$/, "");
          const isHome =
            normalizedCurrent === "/" ||
            normalizedCurrent === "" ||
            normalizedCurrent === `${basePath}/` ||
            normalizedCurrent === basePath;
          const isActive =
            (item.id === "home" && isHome) ||
            (item.id === "resume" && normalizedCurrent.includes("/resume")) ||
            (item.id === "writing" && normalizedCurrent.includes("/writing")) ||
            (item.id === "artifacts" && normalizedCurrent.includes("/artifacts"));
          return (
            <a
              href={item.href}
              class={`nav-link font-label-mono text-label-mono-xs uppercase px-1 h-full flex items-center transition-none select-none whitespace-nowrap tracking-wider border-b-2 -mb-px ${
                isActive
                  ? "border-text-primary text-text-primary font-bold"
                  : "border-transparent text-text-secondary hover:text-text-primary hover:border-border-hairline"
              }`}
              data-nav-id={item.id}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Right Controls: Theme Switcher -->
    <div class="flex items-center gap-space-sm shrink-0 pl-space-md">
      <button
        id="theme-toggle"
        type="button"
        title="Toggle Light / Dark Mode"
        class="flex items-center gap-1.5 px-space-sm py-0.5 border border-border-hairline bg-surface-canvas hover:bg-surface-subtle font-label-mono-xs text-label-mono-xs uppercase text-text-primary cursor-pointer transition-none select-none"
      >
        <span class="w-1.5 h-1.5 bg-accent-spec inline-block"></span>
        <span id="theme-text">[THEME: LIGHT]</span>
      </button>
      <script is:inline>
        (function () {
          const isDark = document.documentElement.classList.contains("dark");
          const el = document.getElementById("theme-text");
          if (el) el.textContent = isDark ? "[THEME: DARK]" : "[THEME: LIGHT]";
        })();
      </script>
    </div>
  </div>
</header>

<script>
  // 1. Theme Toggle Controller
  function updateThemeUI() {
    const isDark = document.documentElement.classList.contains("dark");
    const textEl = document.getElementById("theme-text");
    if (textEl) {
      textEl.textContent = isDark ? "[THEME: DARK]" : "[THEME: LIGHT]";
    }
  }

  function initThemeToggle() {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;

    updateThemeUI();

    btn.onclick = () => {
      const isDark = document.documentElement.classList.contains("dark");
      if (isDark) {
        document.documentElement.classList.remove("dark");
        localStorage.setItem("theme", "light");
      } else {
        document.documentElement.classList.add("dark");
        localStorage.setItem("theme", "dark");
      }
      updateThemeUI();
    };
  }

  // 2. Smooth Scroll To Top when clicking the current page's active nav link
  function handleNavClick(e: MouseEvent) {
    const link = (e.target as HTMLElement)?.closest<HTMLAnchorElement>(".nav-link");
    if (!link) return;
    const href = (link.getAttribute("href") || "").replace(/\/$/, "");
    const pathname = window.location.pathname.replace(/\/$/, "");
    if (href && pathname === href) {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
  }

  document.addEventListener("click", handleNavClick);

  // Initialize Theme Toggle on load and Astro page transitions
  initThemeToggle();

  document.addEventListener("astro:after-swap", () => {
    initThemeToggle();
    if (document.activeElement instanceof HTMLElement) {
      document.activeElement.blur();
    }
  });

  document.addEventListener("astro:page-load", () => {
    initThemeToggle();
  });
</script>
