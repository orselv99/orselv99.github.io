---
import { getCollection } from "astro:content";

export interface UpdateItem {
  date: string;
  tag: string;
  title: string;
  href: string;
}

interface Props {
  title?: string;
  updates?: UpdateItem[];
  class?: string;
  limit?: number;
}

const {
  title = "RECENT UPDATES & DISPATCHES",
  updates: propUpdates,
  class: className = "",
  limit = 5,
} = Astro.props;

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");

let displayUpdates = propUpdates;

if (!displayUpdates) {
  const rawPosts = await getCollection("writing");
  displayUpdates = rawPosts
    .map((post) => {
      const uuid = post.id.split("/").pop()?.replace(/\.md$/, "") || post.id;
      const rawDate = post.data.date;
      const tag = post.data.tags?.[0] || post.data.category || "DISPATCH";
      return {
        date: rawDate,
        tag: tag.toUpperCase(),
        title: post.data.title,
        href: `${basePath}/writing/${uuid}`,
      };
    })
    .sort((a, b) => (b.date > a.date ? 1 : b.date < a.date ? -1 : 0))
    .slice(0, limit);
}
---

<div
  class:list={[
    "border border-border-hairline bg-surface-canvas h-full flex flex-col justify-between",
    className,
  ]}
>
  <div>
    <!-- Header Bar -->
    <div
      class="h-10 bg-surface-subtle px-space-md border-b border-border-hairline flex items-center justify-between"
    >
      <span
        class="font-label-mono-xs text-label-mono-xs uppercase font-semibold tracking-wider text-text-primary"
      >
        {title}
      </span>
    </div>

    <!-- List of items -->
    <div
      class="divide-y divide-border-hairline font-label-mono text-label-mono"
    >
      {
        displayUpdates.map((item) => (
          <a
            href={item.href}
            class="group grid grid-cols-1 sm:grid-cols-12 px-space-md py-space-sm items-baseline hover:bg-surface-subtle transition-none gap-y-1"
          >
            <div class="sm:col-span-3 font-code-block text-label-mono-xs text-text-secondary whitespace-nowrap">
              {item.date}
            </div>
            <div class="sm:col-span-8 font-body-sm text-body-sm font-semibold text-text-primary group-hover:underline truncate pr-space-xs">
              {item.title}
            </div>
            <div class="sm:col-span-1 text-right font-label-mono text-label-mono font-bold text-text-primary group-hover:translate-x-0.5 transition-none">
              →
            </div>
          </a>
        ))
      }
    </div>
  </div>
</div>
