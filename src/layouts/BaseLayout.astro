---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = "RESEARCH//SYSTEMS — Systems Architect & Compiler Researcher",
  description = "Deterministic runtime systems, type-directed synthesis, and verified distributed state machines. Editorial Rationalism & Swiss Technical brutalist archive.",
  currentPath = "/",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <!-- Inlined Theme Detection (Zero FOUC) -->
    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem("theme");
        if (
          savedTheme === "dark" ||
          (!savedTheme &&
            window.matchMedia("(prefers-color-scheme: dark)").matches)
        ) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>
  </head>
  <body
    class="bg-surface-canvas font-body-md text-body-md text-text-primary antialiased min-h-screen flex flex-col p-4 sm:p-6 md:p-10 lg:p-14"
  >
    <div class="max-w-[1140px] w-full mx-auto flex flex-col flex-1">
      <Header currentPath={currentPath} />
      <main class="w-full flex-1 bg-surface-canvas py-space-lg md:py-space-lg">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
